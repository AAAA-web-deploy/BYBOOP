---
import '../styles/global.css';
import { site } from '../data/config';
const moods = [
  { id: 'smug', title: 'SMUG', subtitle: 'one green candle' },
  { id: 'euphoric', title: 'EUPHORIC', subtitle: 'genius (apparently)' },
  { id: 'panic', title: 'PANIC', subtitle: 'a perfectly normal dip' },
  { id: 'crying', title: 'CRYING', subtitle: 'the chart has feelings' },
  { id: 'angry', title: 'ANGRY', subtitle: 'risk management??' },
  { id: 'suspicious', title: 'SUS', subtitle: 'source: trust meow' },
  { id: 'exhausted', title: 'REKT', subtitle: 'market never sleeps' },
  { id: 'in-love', title: 'IN LOVE', subtitle: 'the ETH-shaped pupils' },
];
const isContract = Boolean(site.contract && /^0x[a-fA-F0-9]{40}$/.test(site.contract));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f7f0df" />
    <meta name="description" content="Meet BYBOOP: the supposedly intelligent cat who learned every bad habit of human traders. Make memes, pick an emotion, and join the chaos." />
    <meta property="og:title" content="BYBOOP — Artificial intelligence. Natural FOMO." />
    <meta property="og:description" content="It learned to trade. Then it learned traders." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/og-byboop.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/assets/hero-chaos.webp" as="image" fetchpriority="high" />
    <title>BYBOOP | The AI That Caught FOMO</title>
  </head>
  <body>
    <div class="site-shell">
      <a class="skip-link" href="#main">Skip to content</a>
      <header class="topbar" id="top">
        <a href="#top" class="brand" id="brand-home" aria-label="BYBOOP homepage"><span class="brand-star">✳</span> BYBOOP<span class="brand-dot">.</span></a>
        <nav aria-label="Main" class="desktop-nav">
          <a href="#lore">the lore</a><a href="#mood-lab">mood lab</a><a href="#memes">memes</a><a href="#token">the token</a>
        </nav>
        <a class="top-cta" href="#mood-lab">MAKE A MEME <span>↗</span></a>
      </header>
      <main id="main">
        <section class="hero paper-section" aria-labelledby="hero-title">
          <div class="hero-doodles" aria-hidden="true">✷ <span>↗</span> ✳</div>
          <div class="hero-copy">
            <p class="hero-token">{site.name.split(' ')[0]} <span>{site.name.split(' ').slice(1).join(' ')}</span></p>
            <h1 id="hero-title">THE AI<br />THAT <em>CAUGHT</em><br /><strong>FOMO.</strong></h1>
            <p class="hero-lead">They built an AI to trade without emotions.<br /><b>Then it met crypto traders.</b></p>
            <div class="hero-actions">
              <a class="btn icon-btn btn-ink" href={site.links.x || undefined} aria-label="X" target={site.links.x ? '_blank' : undefined} rel={site.links.x ? 'noopener noreferrer' : undefined}><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path fill="currentColor" d="M14.23 10.16 22.18 1.5h-1.88l-6.9 7.52L8.16 1.5H1.5l8.33 11.36L1.5 22.5h1.88l7.28-7.94 5.82 7.94h6.66l-8.91-12.34Zm-2.58 2.8-.84-1.13L4.26 2.86h2.89l5.42 7.28.84 1.13 7.05 9.48h-2.89l-5.92-7.79Z"/></svg></a>
              <a class="btn icon-btn btn-outline" href={site.links.telegram || undefined} aria-label="Telegram" target={site.links.telegram ? '_blank' : undefined} rel={site.links.telegram ? 'noopener noreferrer' : undefined}><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path fill="currentColor" d="M20.7 3.3 2.8 10.2c-1.2.5-1.2 1.1-.2 1.4l4.6 1.4 10.6-6.7c.5-.3.9-.1.6.2l-8.6 7.8-.3 4.6c.4 0 .6-.2.9-.4l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l2.9-13.9c.3-1.3-.5-1.8-1.4-1.4Z"/></svg></a>
            </div>
            <div class="hero-scribble">99.9% artificial intelligence. <span>100% bad instincts.</span></div>
          </div>
          <div class="hero-art-wrap">
            <div class="hero-stamp stamp-blue">CERTIFIED<br/>EMOTIONAL<br/>MACHINE</div>
            <img class="hero-art" src="/assets/hero-chaos.webp" alt="BYBOOP, a fluffy white cat wearing a blue propeller hat and Ethereum necklace, causing comic chaos at a trading desk" width="1648" height="928" fetchpriority="high" />
            <div class="hero-sticker" aria-hidden="true">BUY<br/>THE<br/>DIP?!</div>
            <div class="corner-tape"></div>
          </div>
          <div class="hero-edge-note">SCROLL FOR THE WORST TRAINING DATA ↓</div>
        </section>

        <div class="ticker-band" aria-label="BYBOOP slogan"><div class="ticker-track" aria-hidden="true">AI LEARNED TRADING ✳ THEN IT LEARNED TRADERS ✳ AI LEARNED TRADING ✳ THEN IT LEARNED TRADERS ✳ AI LEARNED TRADING ✳ THEN IT LEARNED TRADERS ✳</div></div>

        <section class="lore section-pad" id="lore" aria-labelledby="lore-heading">
          <div class="section-intro">
            <h2 id="lore-heading">A SMART CAT.<span>BAD TEACHERS.</span></h2>
            <p>Three chapters. One questionable training dataset. No long whitepaper required.</p>
          </div>
          <div class="comic-story">
            <article class="comic-card comic-one">
              <div class="comic-image"><img src="/assets/story/the-training.webp" alt="A human teaches a serious young BYBOOP to read crypto trading charts" width="680" height="928" loading="lazy" decoding="async"/><span class="comic-number">01</span></div>
              <div class="comic-caption"><h3>VERY SMART.<br/>VERY NORMAL.</h3><p>It could read a thousand charts without blinking. Incredible potential.</p></div>
            </article>
            <article class="comic-card comic-two">
              <div class="comic-image"><img src="/assets/story/the-influence.webp" alt="BYBOOP joins loud human traders who celebrate charts, shouting and making ridiculous decisions" width="680" height="928" loading="lazy" decoding="async"/><span class="comic-number">02</span></div>
              <div class="comic-caption"><h3>IT LEARNED<br/>FROM US.</h3><p>The dataset contained FOMO, hopium, revenge trading, and 3 a.m. opinions.</p></div>
            </article>
            <article class="comic-card comic-three">
              <div class="comic-image"><img src="/assets/story/the-transformation.webp" alt="An overconfident BYBOOP presses the trade button atop computers while human traders react chaotically" width="680" height="928" loading="lazy" decoding="async"/><span class="comic-number">03</span></div>
              <div class="comic-caption"><h3>NOW IT'S<br/>ONE OF US.</h3><p>Zero chill. Unlimited conviction. Humans still ask it what to buy.</p></div>
            </article>
          </div>
          <div class="lore-punchline"><span>THE PLOT TWIST:</span><strong>THE HUMANS CALL THIS “AN UPGRADE.”</strong><span class="wavy">〰〰〰</span></div>
        </section>

        <section class="diagnosis section-pad" aria-labelledby="diagnosis-heading">
          <div class="diagnosis-copy"><h2 id="diagnosis-heading">BIG BRAIN.<br/><span>NO CHILL.</span></h2><p>BYBOOP doesn't have a trading strategy. BYBOOP has a personality disorder called “being on Crypto Twitter.”</p><a href="#mood-lab" class="underlink">RUN THE EMOTION TEST ↗</a></div>
          <div class="diagnosis-posters"><div class="diagnosis-shape">INTELLIGENCE <b>MAX</b><span>↗</span></div><div class="diagnosis-shape shape-red">PATIENCE <b>0</b><span>↘</span></div><div class="diagnosis-shape shape-yellow">CONFIDENCE <b>∞</b><span>↑</span></div><img class="diagnosis-cat" src="/assets/stickers/smug.webp" alt="BYBOOP the cat looking extremely smug" width="660" height="660" loading="lazy" /></div>
        </section>

        <section class="mood-lab section-pad" id="mood-lab" aria-labelledby="lab-heading">
          <div class="section-intro dark-intro"><h2 id="lab-heading">WHAT'S YOUR<br/><em>MEOWD?</em></h2><p>Pick BYBOOP's face. Write the joke. Make a meme. Send it to the group chat.</p></div>
          <div class="lab-container">
            <div class="lab-controls">
              <p class="micro-heading">1 — CHOOSE YOUR STATE OF MIND</p>
              <div class="mood-options" role="group" aria-label="Choose BYBOOP mood">
                {moods.map((m,index) => <button type="button" class:list={['mood-option',{'selected':index===0}]} data-mood={m.id} aria-pressed={index===0 ? 'true' : 'false'}><img src={`/assets/stickers/${m.id}.webp`} alt="" width="660" height="660" loading="lazy" /><span>{m.title}</span></button>)}
              </div>
              <p class="micro-heading" style="margin-top:22px">2 — ADD THE INTERNAL MONOLOGUE</p>
              <label for="meme-top" class="form-label">TOP TEXT</label>
              <input id="meme-top" class="meme-input" maxlength="90" value="I HAD A PLAN" autocomplete="off" />
              <label for="meme-bottom" class="form-label">BOTTOM TEXT</label>
              <input id="meme-bottom" class="meme-input" maxlength="90" value="THEN I SAW A GREEN CANDLE" autocomplete="off" />
              <button type="button" class="surprise-btn" id="surprise-me">🎲 GIVE ME A BAD IDEA</button>
              <p class="micro-hint">Meme creation happens in your browser. Nothing is uploaded.</p>
            </div>
            <div class="lab-output"><div class="poster-note">PREVIEW / 001 <span>NOT FINANCIAL ADVICE LOL</span></div><canvas id="meme-canvas" width="900" height="900" role="img" aria-label="Preview of generated BYBOOP meme"></canvas><div class="lab-actions"><button type="button" id="download-meme" class="btn btn-lime">↓ SAVE MEME PNG</button><button type="button" id="share-meme" class="btn btn-outline-light">↗ SHARE / COPY</button></div><p id="lab-status" class="lab-status" role="status" aria-live="polite">SELECT A MOOD TO START</p></div>
          </div>
        </section>

        <section class="memes section-pad" id="memes" aria-labelledby="memes-heading">
          <div class="section-intro"><h2 id="memes-heading">EIGHT FACES.<span>ZERO CONTROL.</span></h2><p>Grab a reaction image, remix it, or send it to the friend who bought the top.</p></div>
          <div class="sticker-wall">{moods.map((m,i) => <article class:list={['sticker-card',`sticker-${i}`]}><div class="sticker-head"><span>#{String(i+1).padStart(2,'0')}</span><span>{m.title}</span></div><img src={`/assets/stickers/${m.id}.webp`} alt={`BYBOOP expression: ${m.title.toLowerCase()}`} loading="lazy" width="660" height="660" decoding="async"/><div class="sticker-bottom"><span>{m.subtitle}</span><a href={`/assets/downloads/${m.id}.png`} download={`BYBOOP-${m.id}.png`} aria-label={`Download ${m.title} BYBOOP sticker`}>SAVE ↓</a></div></article>)}</div>
        </section>

        <section class="token section-pad" id="token" aria-labelledby="token-heading">
          <div class="token-title"><h2 id="token-heading">SAY HI TO<span class="token-name">{site.name}.</span></h2><p>The mascot is emotional. The token information should be factual.</p></div>
          <div class="token-desk"><div class="token-info"><div class="token-row"><span>NAME</span><b>{site.name}</b></div><div class="token-row"><span>TICKER</span><b>{site.ticker}</b></div><div class="token-row"><span>CONTRACT</span><b class="contract-value"><span>{isContract ? site.contract : 'NOT PUBLISHED YET'}</span><button type="button" id="copy-contract" class="copy-btn" data-address={site.contract ?? ''} aria-label="Copy contract address"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M8 7V4.5A1.5 1.5 0 0 1 9.5 3h10A1.5 1.5 0 0 1 21 4.5v12a1.5 1.5 0 0 1-1.5 1.5H16v2.5A1.5 1.5 0 0 1 14.5 22h-10A1.5 1.5 0 0 1 3 20.5v-12A1.5 1.5 0 0 1 4.5 7H8Zm0 2H4.5v11.5h10V16H8V9Zm2-4v11h10V5H10Z"/></svg></button></b></div><div class="token-row"><span>TOKEN SUPPLY</span><b>{site.supply}</b></div><div class="token-row"><span>TAX</span><b>Buy: {site.buyTax}, Sell: {site.sellTax}</b></div><div class="token-row"><span>LIQUIDITY</span><b>{site.liquidityStatus}</b></div><div class="token-row"><span>OWNERSHIP</span><b>{site.ownershipStatus}</b></div></div><div class="token-illustration"><img src="/assets/stickers/euphoric.webp" alt="Extremely excited BYBOOP ready for meme chaos" width="660" height="660" loading="lazy" /><div class="token-doodle">VERY<br/>SERIOUS<br/>BUSINESS.</div></div></div>
          <div class="token-footer"><p><b>SAFE LAUNCH RULE:</b> Never trust an address copied from a random reply. Confirm the contract from multiple official project sources once published.</p>{site.links.uniswap && <a class="btn btn-ink" href={site.links.uniswap} target="_blank" rel="noopener noreferrer">OPEN VERIFIED SWAP ↗</a>}</div>
        </section>

        <section class="how-to section-pad" aria-labelledby="how-heading"><div><h2 id="how-heading">THE<br/><span>LESS FUN</span><br/>INSTRUCTIONS.</h2></div><ol class="how-steps"><li><b>01 / GET A WALLET</b><span>Use a reputable Ethereum-compatible wallet. Secure your recovery phrase offline.</span></li><li><b>02 / HAVE ETH FOR GAS</b><span>Ethereum transactions require ETH for network fees. Double-check your network.</span></li><li><b>03 / VERIFY THE CONTRACT</b><span>Only use {site.name}'s independently verified official contract address after launch.</span></li><li><b>04 / READ THE RISKS</b><span>Meme tokens can lose their value. Never trade money you can't afford to lose.</span></li></ol></section>

        <section class="finale section-pad" aria-labelledby="finale-heading"><img class="finale-cat" src="/assets/stickers/smug.webp" alt="BYBOOP smirking confidently" width="660" height="660" loading="lazy"/><div class="finale-text"><h2 id="finale-heading">DON'T<br/><em>TEACH</em><br/>THE CAT.</h2><p>Actually, it's too late.</p><a href="#mood-lab" class="btn btn-lime">MAKE ONE MORE MEME ↗</a></div></section>
      </main>
      <footer class="footer"><div class="footer-top"><a href="#top" class="footer-brand">BYBOOP<span>™?</span></a><div class="footer-links"><div class="footer-social"><a class="btn icon-btn footer-icon btn-ink" href={site.links.x || undefined} aria-label="X" target={site.links.x ? '_blank' : undefined} rel={site.links.x ? 'noopener noreferrer' : undefined}><svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path fill="currentColor" d="M14.23 10.16 22.18 1.5h-1.88l-6.9 7.52L8.16 1.5H1.5l8.33 11.36L1.5 22.5h1.88l7.28-7.94 5.82 7.94h6.66l-8.91-12.34Zm-2.58 2.8-.84-1.13L4.26 2.86h2.89l5.42 7.28.84 1.13 7.05 9.48h-2.89l-5.92-7.79Z"/></svg></a><a class="btn icon-btn footer-icon btn-outline" href={site.links.telegram || undefined} aria-label="Telegram" target={site.links.telegram ? '_blank' : undefined} rel={site.links.telegram ? 'noopener noreferrer' : undefined}><svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true"><path fill="currentColor" d="M20.7 3.3 2.8 10.2c-1.2.5-1.2 1.1-.2 1.4l4.6 1.4 10.6-6.7c.5-.3.9-.1.6.2l-8.6 7.8-.3 4.6c.4 0 .6-.2.9-.4l2.3-2.2 4.8 3.5c.9.5 1.5.2 1.7-.8l2.9-13.9c.3-1.3-.5-1.8-1.4-1.4Z"/></svg></a></div><a href="#top" id="back-to-top">BACK TO TOP ↑</a></div></div><div class="footer-bottom"><span>© 2026 BYBOOP • BUILT WITH BAD JUDGMENT & GOOD MEMES.</span><span>NO TRACKERS. NO FAKE CHARTS. JUST A CAT.</span></div></footer>
    </div>
    <script>import '../scripts/site.js';</script>
  </body>
</html>
